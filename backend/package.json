{
  "name": "sistema-delivery-backend",
  "version": "1.0.0",
  "description": "Backend para Sistema de Gestão de Delivery usando Node + Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "migrate": "ts-node src/scripts/initDatabase.ts",
    "add-test-product": "ts-node src/scripts/addTestProduct.ts",
    "add-test-category": "ts-node src/scripts/addTestCategory.ts"
  },
  "keywords": [
    "delivery",
    "backend",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "lowdb": "^6.0.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.15.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.2",
    "@types/uuid": "^9.0.1",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
