# Exemplo de variáveis de ambiente para o backend
# Copie este arquivo para `.env` e ajuste os valores locais.

# Porta da aplicação
PORT=3000

# Ambiente (development | production)
NODE_ENV=development

# JWT
JWT_SECRET=uma_chave_forte_aqui
JWT_EXPIRES_IN=1d

# Configurações do banco (se migrar para MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha_do_banco
DB_DATABASE=sistema_delivery

# Opções opcionais
# LOG_LEVEL=debug
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
